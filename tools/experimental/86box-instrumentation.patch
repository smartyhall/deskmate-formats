+/* Input-event accounting for the instrumented build. These counters describe
+   what the automation interface accepted, handed to the keyboard controller and
+   discarded. They are not a claim about the BIOS ring or about what an
+   application consumed: only `queue` (occupancy) says anything about work the
+   emulator still owes the guest. */
+static uint64_t key_seq;      /* monotonic id of the last accepted key request */
+static uint64_t key_accepted; /* events queued by key requests */
+static uint64_t key_forwarded;/* events passed to keyboard_input() */
+static uint64_t key_dropped;  /* queued events discarded or cancelled */
+static uint32_t key_generation; /* bumped whenever a reset discards pending input */
+
+/* Forward the next due event, if any. The accounting invariant is
+   accepted == forwarded + dropped + pending; this is the only function that
+   moves an event from pending to forwarded outside the request itself, so both
+   the key command and a queue-wait use it. */
+static int
+key_pump(void)
+{
+    if (key_head >= key_count)
+        return 0;
+    if (emu_ms < key_next_ms)
+        return 0;
+    keyboard_input(key_queue[key_head].down, key_queue[key_head].scan);
+    key_forwarded++;
+    key_head++;
+    key_next_ms = emu_ms + KEY_GAP_MS;
+    return 1;
+}
+static int64_t  mouse_sent_dx;
+static int64_t  mouse_sent_dy;
+static uint32_t mouse_sent_buttons;
