+
+/* Instrumentation for the automation interface: how many scancodes the keyboard
+   device currently holds as pressed. This samples the device's pressed-key
+   table, which is not a keystroke FIFO and is not the BIOS ring. */
+int
+keyboard_held_count(void)
+{
+    int n = 0;
+
+    for (int i = 0; i < 768; i++) {
+        if (recv_key[i])
+            n++;
+    }
+    return n;
+}
