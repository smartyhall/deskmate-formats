<!doctype html>
<html lang="en" data-bs-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{% if summary %}{{ summary | escape }}{% else %}Evidence-based Tandy DeskMate format and application reference{% endif %}">
  <title>{{ title | default("Reference") | escape }} | DeskMate Reference</title>
  {% if canonicalUrl %}<link rel="canonical" href="{{ canonicalUrl }}">{% endif %}
  <link rel="stylesheet" href="{{ '/assets/vendor/bootstra386/css/bootstrap.min.css' | siteurl }}">
  <link rel="stylesheet" href="{{ '/assets/site-layout.css' | siteurl }}">
</head>
<body>
  <a class="visually-hidden-focusable" href="#content">Skip to content</a>
  <div class="container-fluid">
    <header class="py-3">
      <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
        <span aria-hidden="true">[DM]</span>
        <a href="{{ '/' | siteurl }}">DESKMATE REFERENCE</a>
        <small>INDEPENDENT HISTORY &amp; RESEARCH</small>
      </div>
      <nav class="navbar navbar-expand bg-body-tertiary" aria-label="Primary">
        <div class="navbar-nav flex-row flex-wrap">
          <a class="nav-link px-2" href="{{ '/' | siteurl }}">Home</a>
          {% for section in navigation %}
          <a class="nav-link px-2" href="{{ ('/' + section.hub.slug + '/') | siteurl }}"
             {% if currentSection and currentSection.id == section.id %}aria-current="true"{% endif %}>{{ section.shortTitle | escape }}</a>
          {% endfor %}
          <a class="nav-link px-2" href="{{ '/search/' | siteurl }}">Search</a>
          <a class="nav-link px-2" href="https://github.com/smartyhall/deskmate-formats">Source repository</a>
        </div>
      </nav>
    </header>
    <div class="row g-4">
      <main id="content" class="col-12 col-lg-9 order-1 order-lg-2" tabindex="-1">
        {% if breadcrumbs %}
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            {% for crumb in breadcrumbs %}
            <li>{% if crumb.href %}<a href="{{ crumb.href }}">{{ crumb.label | escape }}</a>{% elif loop.last %}<span aria-current="page">{{ crumb.label | escape }}</span>{% else %}<span>{{ crumb.label | escape }}</span>{% endif %}</li>
            {% endfor %}
          </ol>
        </nav>
        {% endif %}
        {% if sourceRoleLabel %}
        <div class="alert alert-info source-role" role="note">
          <strong>{{ sourceRoleLabel | escape }}</strong>{% if sourceDateLabel %} <time datetime="{{ sourceDateIso }}">{{ sourceDateLabel | escape }}</time>{% endif %}
          <span>— Read the claims here in the context of the source's date and the evidence behind it.</span>
        </div>
        {% endif %}
        <article class="document">{{ content | safe }}</article>
        {% if sourceLink %}
        <p class="source-note"><a href="{{ sourceLink }}">Review the source Markdown and history</a></p>
        {% endif %}
      </main>
      <aside class="col-12 col-lg-3 order-2 order-lg-1" id="reference-sections" aria-label="Section navigation">
        <nav aria-label="Section contents">
        {% if currentSection %}
          <p class="sidebar-hub"><a href="{{ ('/' + currentSection.hub.slug + '/') | siteurl }}">{{ currentSection.shortTitle | escape }}</a></p>
          {% for group in currentSection.subsections %}
          <details open>
            <summary>{{ group.title | escape }}</summary>
            <ul>
            {% for item in group.pages %}
              <li><a href="{{ ('/' + item.slug + '/') | siteurl }}"
               {% if currentId == item.id %}aria-current="page"{% endif %}>{{ item.title }}</a></li>
            {% endfor %}
            </ul>
          </details>
          {% endfor %}
          <p class="sidebar-heading">Other sections</p>
          <ul class="sidebar-hubs">
          {% for section in navigation %}
            {% if section.id != currentSection.id %}
            <li><a href="{{ ('/' + section.hub.slug + '/') | siteurl }}">{{ section.shortTitle | escape }}</a></li>
            {% endif %}
          {% endfor %}
          </ul>
        {% else %}
          <p class="sidebar-heading">Sections</p>
          <ul class="sidebar-hubs">
          {% for section in navigation %}
            <li><a href="{{ ('/' + section.hub.slug + '/') | siteurl }}">{{ section.shortTitle | escape }}</a></li>
          {% endfor %}
          </ul>
        {% endif %}
        </nav>
      </aside>
    </div>
    <footer class="border-top mt-5 py-3">
      <p>Independent preservation research. Not affiliated with Tandy or Radio Shack.
      <a href="https://github.com/smartyhall/deskmate-formats/blob/main/LICENSING.md">Project licensing</a>.</p>
      <p>Unmodified <a href="https://github.com/kristopolous/BOOTSTRA.386">BOOTSTRA.386</a> display theme.
      Bootstrap (MIT); BOOTSTRA.386 (Apache-2.0); typeface by VileR (CC BY-SA 4.0).
      <a href="{{ '/assets/vendor/bootstra386/ATTRIBUTION.txt' | siteurl }}">Theme attribution</a>.</p>
    </footer>
  </div>
  <script defer src="{{ '/assets/vendor/bootstra386/js/bootstrap.bundle.min.js' | siteurl }}"></script>
  <script defer src="{{ '/assets/vendor/bootstra386/js/bootstrap-386.js' | siteurl }}"></script>
  <script>
    // The theme injects a decorative cursor element (#cursor386) directly into
    // the body, outside every landmark. It is purely visual, so it is hidden
    // from assistive technology rather than moved or removed.
    window.addEventListener('load', function () {
      var cursor = document.getElementById('cursor386');
      if (cursor) cursor.setAttribute('aria-hidden', 'true');
    });
  </script>
</body>
</html>
