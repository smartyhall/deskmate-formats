  "observations": [
    {
      "id": "tandy-rl-announcement-day",
      "subject": "Tandy 1000 RL",
      "claim": "The article places the New York introduction on July 25 and cites the 1991 computer catalog elsewhere. The announcement year is implicit in this copy.",
      "evidence": [
        {
          "source_id": "tandy-1000-rl",
          "lines": [
            5,
            9
          ]
        },
        {
          "source_id": "tandy-1000-rl",
          "lines": [
            319,
            323
          ]
        }
      ]
    },
    {
      "id": "tandy-rlx-announcement-day",
      "subject": "Tandy 1000 RLX",
      "claim": "The article gives April 18 as the introduction day. The February 1992 newsletter establishes that the hard-drive model was already being repriced by then.",
      "evidence": [
        {
          "source_id": "tandy-1000-rlx",
          "lines": [
            5,
            11
          ]
        },
        {
          "source_id": "newsletter-1992-02",
          "lines": [
            143,
            151
          ]
        }
      ]
    },
    {
      "id": "tandy-rlx-draw-fonts",
      "subject": "Draw scalable font extension",
      "claim": "A Radio Shack article describes three included scalable fonts and additional fonts sold through Express Order for the RLX edition of Draw. It gives no order numbers or typeface names.",
      "evidence": [
        {
          "source_id": "tandy-1000-rlx-software",
          "lines": [
            175,
            194
          ]
        }
      ]
    },
    {
      "id": "tandy-rsx-bundle",
      "subject": "RSX versus RLX software bundles",
      "claim": "The RLX list includes PC-Link. The RSX article lists eight core applications without PC-Link and names America Online and Print Companion separately in the RSX bundle.",
      "evidence": [
        {
          "source_id": "tandy-1000-rlx",
          "lines": [
            151,
            155
          ]
        },
        {
          "source_id": "tandy-1000-rsx",
          "lines": [
            32,
            38
          ]
        },
        {
          "source_id": "tandy-1000-rsx",
          "lines": [
            145,
            148
          ]
        }
      ]
    },
    {
      "id": "tandy-dmp136-deskmate",
      "subject": "DeskMate printing on the DMP 136",
      "claim": "The period article directs DeskMate users to its IBM Proprinter driver for monochrome text and graphics. It describes color via printer emulation with compatible applications and reports no DeskMate color driver planned at that time.",
      "evidence": [
        {
          "source_id": "printer-dmp136",
          "lines": [
            27,
            48
          ]
        }
      ]
    },
    {
      "id": "tandy-tl3-discontinuation",
      "subject": "Tandy 1000 TL/3",
      "claim": "The July 1992 vendor newsletter reports that the last TL-series machine, the TL/3, was discontinued in 1991. It separately notes the TL/2's 8-bit bus despite its 80286 CPU.",
      "evidence": [
        {
          "source_id": "newsletter-1992-07",
