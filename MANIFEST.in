include README.md AGENTS.md CONTRIBUTING.md LICENSE-DECISION.md LICENSING.md LICENSE
include *.license
include .gitattributes .gitignore
recursive-include LICENSES *.txt
recursive-include docs *.md *.json *.license
recursive-include tests *.py *.md *.license
recursive-include tests/fixtures/application-generated *.json
recursive-include tools *.py *.license
recursive-include experiments *.asm *.license
recursive-include .github *.yml *.yaml *.license
global-exclude *.pyc
